{
  "manifest_version": 3,
  "name": "Honeybon Capture",
  "version": "0.3.1",
  "description": "Sends your accepted LeetCode submissions to Honeybon for review, and pastes its solutions into LeetCode for you to try.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://honey-bon.vercel.app/*",
    "http://localhost:5173/*",
    "https://leetcode.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["page-hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://honey-bon.vercel.app/*", "http://localhost:5173/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Honeybon",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  }
}
